{
    "name": "agenttalk",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently -k -n api,web -c blue,yellow \"yarn dev:api\" \"yarn dev:web\"",
        "build": "tsc -b && vite build --mode production",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
        "format": "prettier --write .",
        "preview": "vite preview",
        "prepare": "husky",
        "test-once": "vitest run",
        "test": "vitest --watch",
        "commitlint": "commitlint --edit",
        "dev:web": "vite --open",
        "dev:api": "tsx watch server/index.ts",
        "start": "NODE_ENV=production tsx server/index.ts"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.78",
        "@ai-sdk/deepseek": "^3.0.63",
        "@ai-sdk/google": "^4.0.93",
        "@ai-sdk/groq": "^4.0.59",
        "@ai-sdk/mistral": "^4.0.62",
        "@ai-sdk/openai": "^4.0.91",
        "@ai-sdk/openai-compatible": "^3.0.67",
        "@ai-sdk/xai": "^5.0.20",
        "@hono/node-server": "^2.1.4",
        "@hookform/resolvers": "^5.2.2",
        "@tailwindcss/vite": "^4.1.10",
        "@tanstack/react-query": "^5.95.2",
        "@uidotdev/usehooks": "^2.4.1",
        "ai": "^7.0.137",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.20",
        "hono": "^4.13.13",
        "i18next": "^25.10.9",
        "jotai": "^2.19.0",
        "ky": "^1.14.3",
        "lucide-react": "^0.469.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.72.0",
        "react-hot-toast": "^2.6.1",
        "react-i18next": "^15.4.1",
        "react-markdown": "^10",
        "react-router": "^7.18.2",
        "remark-gfm": "^4",
        "tailwind-merge": "^2.6.0",
        "zod": "^4"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.6.1",
        "@commitlint/config-conventional": "^19.6.0",
        "@eslint/js": "^9.18.0",
        "@tailwindcss/postcss": "^4.1.10",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.6.4",
        "@types/node": "^22.10.7",
        "@types/react": "^19.0.7",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react-swc": "^3.7.2",
        "concurrently": "^10.0.6",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-better-tailwindcss": "^4.5.0",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.4.16",
        "globals": "^15.14.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^17.3.0",
        "msw": "^2.7.0",
        "postcss": "^8.5.23",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.1.10",
        "tsx": "^4.23.15",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.21.0",
        "vite": "^6.4.3",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.6"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md}": [
            "prettier --write"
        ]
    },
    "description": "Kakao-style multi-agent LLM chat",
    "license": "MIT",
    "engines": {
        "node": ">=22.13"
    }
}
